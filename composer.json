{
    "name": "jorisnoo/craft-locale-redirect",
    "description": "Browser locale detection and redirect for Craft CMS",
    "license": "MIT",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "locale",
        "redirect",
        "language",
        "i18n"
    ],
    "authors": [
        {
            "name": "Joris Noordermeer",
            "email": "contact@noordermeer.ch",
            "homepage": "https://github.com/jorisnoo"
        }
    ],
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0",
        "guzzlehttp/psr7": "^2.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0",
        "pestphp/pest": "^3.8"
    },
    "scripts": {
        "check": [
            "composer validate --strict",
            "composer audit",
            "phpstan analyse --no-progress --memory-limit=1G",
            "pest"
        ]
    },
    "autoload": {
        "psr-4": {
            "Noo\\CraftLocaleRedirect\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Noo\\CraftLocaleRedirect\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true
        }
    }
}
